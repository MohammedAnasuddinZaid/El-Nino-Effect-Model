{
  "name": "every-drop-a-story",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive 3D science exhibit about El Niño, rainwater harvesting and drip irrigation.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "icons": "node scripts/make-icons.mjs",
    "narration": "py -3.10 scripts/generate-narration.py"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "lenis": "1.3.27",
    "maath": "0.10.8",
    "motion": "14.6.0",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "^1.58.2",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
